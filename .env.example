# Optional overrides for `docker compose`.
# Copy to `.env` and edit if you want a persistent secret or a different host.
DJANGO_SECRET_KEY=kernl-local-compose-change-me
POSTGRES_PASSWORD=kernl-local
WEB_CONCURRENCY=2
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# These are baked into the Next.js browser bundle at image build time.
# If you access the app through another host, update both values and rebuild.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000
