# Copy to backend/.env for local overrides.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=django-insecure-local-development-key-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite is the default. A local Postgres URL also works:
# DATABASE_URL=postgres://kernl:kernl@127.0.0.1:5432/kernl

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

TERMINAL_SESSION_TTL_SECONDS=1800
TERMINAL_IDLE_TIMEOUT_SECONDS=600
TERMINAL_MAX_LIFETIME_SECONDS=1200
TERMINAL_MAX_SESSIONS=25
TERMINAL_SESSION_THROTTLE=20/min
