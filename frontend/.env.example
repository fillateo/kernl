# Copy to frontend/.env.local if your services do not use the defaults.

# Used by Next.js server components to call Django.
API_URL=http://127.0.0.1:8000

# Used by the browser to create terminal tickets and open the WebSocket.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional override when the WebSocket origin differs from the API origin.
# NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000
